{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Deploys Azure Automation Account with Storage for monitoring Intune Administrative Tasks"
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "automationAccountName": {
      "type": "string",
      "defaultValue": "[concat('aa-intune-monitor-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Name of the Automation Account"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[concat('stintune', uniqueString(resourceGroup().id))]",
      "maxLength": 24,
      "metadata": {
        "description": "Name of the Storage Account (max 24 chars, lowercase)"
      }
    },
    "containerName": {
      "type": "string",
      "defaultValue": "admintasks",
      "metadata": {
        "description": "Name of the blob container for storing task IDs"
      }
    },
    "teamsWebhookUrl": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Microsoft Teams Incoming Webhook URL for notifications"
      }
    },
    "scheduleIntervalMinutes": {
      "type": "int",
      "defaultValue": 15,
      "allowedValues": [5, 10, 15, 30, 60],
      "metadata": {
        "description": "How often to check for new admin tasks (in minutes)"
      }
    },
    "enableSchedule": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable the schedule immediately after deployment"
      }
    }
  },
  "variables": {
    "runbookName": "Monitor-IntuneAdminTasks",
    "scheduleName": "AdminTasksMonitorSchedule",
    "jobScheduleName": "[guid(resourceGroup().id, variables('runbookName'), variables('scheduleName'))]",
    "storageAccountId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "storageBlobDataContributorRole": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]",
    "runbookUri": "https://raw.githubusercontent.com/yourrepo/intune-admin-tasks-monitor/main/scripts/Monitor-AdminTasks.ps1",
    "baseTime": "[dateTimeAdd(utcNow('u'), 'PT1H')]",
    "scheduleStartTime": "[dateTimeAdd(variables('baseTime'), 'PT5M')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "networkAcls": {
          "defaultAction": "Allow",
          "bypass": "AzureServices"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ],
      "properties": {
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 7
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default/', parameters('containerName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts",
      "apiVersion": "2023-11-01",
      "name": "[parameters('automationAccountName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "sku": {
          "name": "Basic"
        },
        "encryption": {
          "keySource": "Microsoft.Automation"
        }
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/variables",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/StorageAccountName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "value": "[concat('\"', parameters('storageAccountName'), '\"')]",
        "isEncrypted": false,
        "description": "Storage account name for storing known task IDs"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/variables",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/ContainerName')]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "value": "[concat('\"', parameters('containerName'), '\"')]",
        "isEncrypted": false,
        "description": "Blob container name"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/variables",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/TeamsWebhookUrl')]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "value": "[concat('\"', parameters('teamsWebhookUrl'), '\"')]",
        "isEncrypted": true,
        "description": "Teams webhook URL for notifications"
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/runbooks",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('runbookName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "runbookType": "PowerShell",
        "logProgress": false,
        "logVerbose": false,
        "description": "Monitors Intune administrative tasks and sends Teams notifications for new tasks",
        "publishContentLink": {
          "uri": "[variables('runbookUri')]",
          "version": "1.0.0.0"
        }
      }
    },
    {
      "type": "Microsoft.Automation/automationAccounts/schedules",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('scheduleName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "description": "Schedule to check for new Intune admin tasks",
        "startTime": "[variables('scheduleStartTime')]",
        "interval": "[parameters('scheduleIntervalMinutes')]",
        "frequency": "Minute",
        "timeZone": "UTC"
      }
    },
    {
      "condition": "[parameters('enableSchedule')]",
      "type": "Microsoft.Automation/automationAccounts/jobSchedules",
      "apiVersion": "2023-11-01",
      "name": "[concat(parameters('automationAccountName'), '/', variables('jobScheduleName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Automation/automationAccounts/runbooks', parameters('automationAccountName'), variables('runbookName'))]",
        "[resourceId('Microsoft.Automation/automationAccounts/schedules', parameters('automationAccountName'), variables('scheduleName'))]"
      ],
      "properties": {
        "runbook": {
          "name": "[variables('runbookName')]"
        },
        "schedule": {
          "name": "[variables('scheduleName')]"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, parameters('automationAccountName'), 'StorageBlobDataContributor')]",
      "scope": "[concat('Microsoft.Storage/storageAccounts/', parameters('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('storageBlobDataContributorRole')]",
        "principalId": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName')), '2023-11-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "automationAccountName": {
      "type": "string",
      "value": "[parameters('automationAccountName')]"
    },
    "automationAccountPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Automation/automationAccounts', parameters('automationAccountName')), '2023-11-01', 'full').identity.principalId]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "runbookName": {
      "type": "string",
      "value": "[variables('runbookName')]"
    },
    "postDeploymentInstructions": {
      "type": "string",
      "value": "IMPORTANT: Run the post-deployment script to assign Microsoft Graph permissions to the Managed Identity. See README for details."
    }
  }
}
