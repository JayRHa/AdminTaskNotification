{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "automationAccountName": {
      "value": "aa-intune-admin-monitor"
    },
    "storageAccountName": {
      "value": "stintuneadmintasks"
    },
    "containerName": {
      "value": "admintasks"
    },
    "teamsWebhookUrl": {
      "value": "YOUR_TEAMS_WEBHOOK_URL_HERE"
    },
    "scheduleIntervalMinutes": {
      "value": 15
    },
    "enableSchedule": {
      "value": true
    }
  }
}
